rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User-scoped data
    match /users/{userId} {
      // Allow users to read/write their own user document (if we use it)
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Teams subcollection
      match /teams/{teamId} {
        // Read if owner or shared member
        allow read: if request.auth != null &&
          (request.auth.uid == userId || (resource.data != null && request.auth.uid in resource.data.sharedUids));

        // Owner can do anything
        allow write: if request.auth != null && request.auth.uid == userId;

        // Delegates can join: only allowed to append their own UID to sharedUids and CLEAR shareCode
        allow update: if request.auth != null
          && resource.data.shareCode != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedUids', 'shareCode'])
          && request.auth.uid in request.resource.data.sharedUids
          && request.resource.data.shareCode == null;
      }
      
      // Matches subcollection
      match /matches/{matchId} {
        // Owner of the folder can do anything
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Collection Group query for matches to support PublicMatchViewer and Shared access
    match /{path=**}/matches/{matchId} {
      // Anyone can 'get' or 'list' (query) a specific match for public viewing
      allow get: if true;
      allow list: if true;
    }

    // Collection Group query for teams to support 'Join with Code' and sync of shared teams
    match /{path=**}/teams/{teamId} {
      allow list: if request.auth != null;
      // Delegates can join by appending their UID to sharedUids and CLEARING shareCode
      allow update: if request.auth != null
        && resource.data.shareCode != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedUids', 'shareCode'])
        && request.auth.uid in request.resource.data.sharedUids
        && request.resource.data.shareCode == null;
    }
  }
}
